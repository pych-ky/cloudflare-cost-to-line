{
  "name": "cloudflare-cost-to-line",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Cloudflare cost forecasts and budget alerts delivered to LINE",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "configure": "node scripts/configure.mjs"
  },
  "dependencies": {
    "postal-mime": "4.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
