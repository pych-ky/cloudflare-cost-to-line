{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-cost-to-line",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 15 * * *"] },
  "vars": {
    "TIME_ZONE": "Asia/Tokyo",
    "MONTHLY_FIXED_COST_USD": "0"
  },
  "durable_objects": {
    "bindings": [{ "name": "NOTIFICATIONS", "class_name": "NotificationStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationStore"] }]
}
